# Environment Variables — Ganesh Chitra Shaala
# Copy this file to .env.local and fill in values as needed.
# None of these are required for a basic deployment.

# ── Analytics (optional) ───────────────────────────────────────────────────
# Add if you set up Umami or a compatible self-hosted analytics platform.
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-server.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ── Google Maps (optional, for future map integration) ─────────────────────
# Only needed if you enable the MapView component on the Contact page.
# VITE_FRONTEND_FORGE_API_KEY=your-google-maps-api-key
# VITE_FRONTEND_FORGE_API_URL=https://your-maps-proxy-url
